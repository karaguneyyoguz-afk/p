# Gmail IMAP credentials (use an App Password, not your regular password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# CSM API credentials
CSM_USERNAME=your-csm-username
CSM_PASSWORD=your-csm-password

# Dedicated CSM system account for mail-triggered Toplu Kaydırma (bulk
# reservation shift) tickets, so those tickets show "Oluşturan: rpa_otomasyon"
# instead of a personal account. Falls back to CSM_USERNAME/CSM_PASSWORD if unset.
RPA_OTOMASYON_USERNAME=rpa_otomasyon
RPA_OTOMASYON_PASSWORD=

# Flask session signing key (optional — falls back to an insecure dev default)
FLASK_SECRET_KEY=change-me-in-production

# Panel user accounts DB (SQLite by default; point this at a Postgres URL
# later to migrate -- SQLAlchemy models don't need to change).
DATABASE_URL=sqlite:///enigma.db

# First admin panel user, created by `python seed_admin.py` (run once after
# `flask db upgrade`). Not read after that -- change the password from the
# Users screen once logged in.
ADMIN_EMAIL=admin@tatilbudur.com
ADMIN_PASSWORD=change-this-password

# Set to "production" when deployed for real (enables Secure session cookies
# -- requires HTTPS).
FLASK_ENV=development
